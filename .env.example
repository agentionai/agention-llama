# Copy to .env and edit. Read by `agention-llama`, docker compose and scripts/*.sh.

# Where your GGUF files live on the host; mounted at /models in the container.
MODELS_DIR=/home/you/models

PORT=8080

# Host gids for GPU access. Find yours with:
#   getent group render | cut -d: -f3   /   getent group video | cut -d: -f3
# The CLI reads these itself; compose cannot, so set them here.
RENDER_GID=990
VIDEO_GID=44

# --- compose only ----------------------------------------------------------
# `agention-llama run <recipe>` takes the recipe on the command line instead.

# Which presets/*.env to serve with. `router` is empty on purpose: in router
# mode the INI below owns the configuration. The others configure one model:
#   plain | dflash-fp4 | dflash-q8 | mtp-long | ornith-mtp | marshall
# See RECIPES.md for what each one needs and what it was measured at.
PRESET=router

# Model config (INI), used in router mode. The default sets global defaults —
# context, thinking, GPU offload — for every model the router finds in
# MODELS_DIR, and lists no models itself. Copy examples/models.ini to configure
# models individually.
MODELS_INI=./presets/globals.ini

# Extra llama-server arguments. Leave unset and the server comes up in router
# mode over /models, letting the web UI pick the model.
#LLAMA_ARGS=-m /models/Qwen3.8-27B-ROCmFP4-FAST.gguf

# Your llama.cpp fork checkout, for docker-compose.build.yml and scripts/build.sh.
LLAMA_SRC=../llama.cpp
