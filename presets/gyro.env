# Qwen3.8-Flash-Next Gyro-S. A 126B MoE on one 32 GB GPU — 28.8 GiB at 64k context.
#
# Gyro-S stores the routed experts in a rotated basis with a compact rotor code
# (1.71 bits per weight on average), which only this fork can run. It drafts
# against its own MTP head, a 2.7 GB Q4_K_M copy shipped in the same repo as
# mtp-*.gguf, over a 32k-token vocabulary subset (draft step 4.3 -> 1.6 ms).
#
#   agention-llama run gyro -- -hf agentionai/Qwen3.8-Flash-Next-Gyro-GGUF:Gyro-S
#
# -hf also fetches the draft (by its mtp- name) and the vision projector
# (mmproj-F16.gguf, ~1 GiB GPU). Text-only: add --no-mmproj after --.
#
#   Radeon 8060S, greedy, 384 tokens, reasoning off (tok/s):
#                     prose   json   code   copy
#   no drafting        32.3   32.2   32.0   32.2
#   this preset        38.7   57.7   51.5   61.1
#
# Prose gains least: the draft is accepted ~55% of the time there, against
# 85-95% on code and JSON. With sampling at temperature 1.0 the gains shrink.
#
# The 26.8 GB n-gram table stays on disk (--ngram-on-disk) and is read row by
# row; it never needs GPU memory or RAM.
#
# Qwen's recommended thinking-mode sampling (temp 1.0, top-p 0.95, top-k 20,
# min-p 0) is set per request by most clients; pass it after `--` otherwise.
#
# Two GPUs: pass `-- --device Vulkan0 --device-draft Vulkan1` (model on one card, draft on
# the other); a layer split across cards is slower than one card.
#
# Memory: 28.8 GiB at 64k without the draft; the draft adds 3.75 GiB (measured) and
# vision ~1 GiB. On one 32 GB card the draft does not fit next to Gyro-S: run it on a
# second GPU or the CPU (LLAMA_ARG_N_GPU_LAYERS_DRAFT=0), or drop drafting.
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_NGRAM_ON_DISK=1
LLAMA_ARG_JINJA=1

LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_ADAPTIVE=1
LLAMA_ARG_SPEC_DRAFT_N_MIN=2
LLAMA_ARG_SPEC_DRAFT_N_MAX=6
LLAMA_ARG_SPEC_DRAFT_MTP_VOCAB=32768
