# Qwen3.8-27B + FP4 sidecar. A coding agent's fast tier: dflash-fp4 plus batching.
#
# Serving marshall's `fast` tier: many short, structured, tool-call-shaped
# completions. That is exactly the DFlash2 case, with a longer context because
# an agent carries file contents in its prompt.
#
# This is dflash-fp4 plus continuous batching — an agent issues several requests
# concurrently, and without it they serialise behind one another.
#
# Tool-calling agents need the chat template to drive the parser, hence JINJA.
# Switch LLAMA_ARG_SPEC_TYPE to draft-mtp if your sessions routinely run past
# ~10k tokens; see mtp-long for why the ranking inverts with context.
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_UBATCH=512
LLAMA_ARG_BATCH=2048
LLAMA_ARG_JINJA=1
LLAMA_ARG_CONT_BATCHING=1

LLAMA_ARG_SPEC_TYPE=draft-dflash
LLAMA_ARG_SPEC_DRAFT_HF_REPO=agentionai/Qwen3.8-27B-DFlash2-ROCmFP4-FAST-GGUF
LLAMA_ARG_N_GPU_LAYERS_DRAFT=99

LLAMA_ARG_SPEC_DRAFT_ADAPTIVE=1
LLAMA_ARG_SPEC_DRAFT_N_MIN=3
LLAMA_ARG_SPEC_DRAFT_N_MAX=7
