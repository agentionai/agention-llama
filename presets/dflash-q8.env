# The same, against a stock K-quant target — no ROCmFPx conversion needed.
#
# Same method as dflash-fp4, with the z-lab Q8_0 sidecar instead of the FP4 one.
#
# Use this when your target is a stock K-quant Qwen3.8-27B rather than a
# ROCmFP4 conversion: nothing here needs the fork's quant types, so it is the
# portable version of the headline recipe.
#
#   Radeon 8060S, everyday power profile, greedy, 300 tokens:
#                structured   prose
#   fixed n=3       36.6      24.7
#   fixed n=7       35.8      23.0
#   this preset     48.5      25.0     <- beats every fixed setting on both
#
# It also gives up less on prose than the FP4 sidecar does, so if your workload
# is mixed rather than tool-call-shaped, prefer this one.
#
# Do NOT requantise this sidecar to ROCmFPx. Q8_0 stores an fp16 block scale,
# ROCmFPx a UE4M3 byte, and at 8 bits per weight that coarser scale costs ~7
# points of draft acceptance (53.5% against 60.2%) at identical bpw and
# identical tensor routing. The codes are not the problem; the scale is.
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_UBATCH=512
LLAMA_ARG_BATCH=2048
LLAMA_ARG_JINJA=1

LLAMA_ARG_SPEC_TYPE=draft-dflash
LLAMA_ARG_SPEC_DRAFT_HF_REPO=z-lab/Qwen3.8-27B-DFlash2-GGUF:Q8_0
LLAMA_ARG_N_GPU_LAYERS_DRAFT=99

LLAMA_ARG_SPEC_DRAFT_ADAPTIVE=1
LLAMA_ARG_SPEC_DRAFT_N_MIN=3
LLAMA_ARG_SPEC_DRAFT_N_MAX=7
