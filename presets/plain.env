# No speculation — the baseline every other number is measured against.
#
# No speculative decoding — the baseline, and what every other number here is
# measured against.
#
# Context and ubatch deliberately match dflash-fp4 so that swapping the preset
# is a single-variable experiment. If you change them there, change them here
# too, or the comparison stops meaning anything.
#
#   Radeon 8060S, Qwen3.8-27B ROCmFP4-FAST, greedy, 300 tokens:
#   14.0 t/s on structured output, 14.1 on prose — identical, because with no
#   draft in play the content of the output cannot matter.
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_UBATCH=512
LLAMA_ARG_BATCH=2048
LLAMA_ARG_JINJA=1
